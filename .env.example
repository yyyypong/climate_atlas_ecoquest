# Copy this file to `18.env` (or `.env`) next to serve_game.py and fill in
# your own key, or export these three as environment variables — environment
# variables take priority over the file.
#
# The browser never receives the key. It is only used by the local server when
# it forwards a request to the model provider.
#
# Any OpenAI-compatible endpoint works (DeepSeek, OpenAI, Moonshot, Qwen,
# a local Ollama / vLLM server, ...). Only the three values below are read.

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
